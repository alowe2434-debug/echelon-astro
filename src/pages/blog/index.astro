---
import Base from '../../layouts/Base.astro';
const posts = [
  { slug: 'commercial-lighting-installation-anaheim-ca', title: 'Commercial Lighting Installation in Anaheim, CA: Costs, Title 24 & SCE Rebates', excerpt: 'Commercial lighting in Anaheim costs $3–$12 per sq ft. Full breakdown for warehouses, offices, and retail — with Title 24 requirements, SCE and AUP rebate details, and seismic code considerations.', category: 'Cost Guide · Anaheim, CA', date: 'April 2026', readTime: '10 min read' },
  { slug: 'parking-lot-lighting-bakersfield-ca', title: 'Parking Lot Lighting in Bakersfield, CA: Costs, Title 24 Rules & PG&E Rebates', excerpt: 'Parking lot lighting in Bakersfield costs $2,500–$5,500 per pole. Title 24 LPD limits, PG&E rebates up to $200/fixture, heat-rated fixture specs, and dark sky compliance.', category: 'Parking Lot Lighting · Bakersfield, CA', date: 'April 2026', readTime: '11 min read' },
  { slug: 'warehouse-lighting-aurora-co', title: 'Warehouse Lighting in Aurora, CO: Costs, Fixtures & Xcel Energy Rebates', excerpt: 'Warehouse lighting in Aurora costs $2–$8/sq ft. High-altitude fixture specs, Xcel Energy rebates up to $150/fixture, cold-start driver requirements, and retrofit timelines.', category: 'Warehouse Lighting · Aurora, CO', date: 'April 2026', readTime: '10 min read' },
  { slug: 'commercial-lighting-installation-cost-tampa-fl', title: 'How Much Does Commercial Lighting Installation Cost in Tampa, FL?', excerpt: 'Commercial lighting in Tampa runs $3–$12 per sq ft. Full breakdown covering TECO rebates, Florida Building Code wind requirements, humidity ratings, and project timelines.', category: 'Cost Guide · Tampa, FL', date: 'April 2026', readTime: '9 min read' },
  { slug: 'commercial-lighting-installation-cost-arlington-tx', title: 'How Much Does Commercial Lighting Installation Cost in Arlington, TX?', excerpt: 'Commercial lighting installation in Arlington runs $3–$12 per square foot. Full cost breakdown by facility type, Oncor rebate details, permit requirements, and project timelines.', category: 'Cost Guide · Arlington, TX', date: 'April 2026', readTime: '9 min read' },
  { slug: 'how-to-read-commercial-lighting-schedule', title: 'How to Read a Commercial Lighting Schedule: A Guide for ECs', excerpt: 'Everything on the architectural drawings makes sense once you know the fixture type codes, mounting details, and how the lighting schedule maps to the electrical plan.', category: 'Specification', date: 'March 2026', readTime: '8 min read' },
  { slug: 'dlc-vs-energy-star-commercial-lighting', title: 'DLC vs ENERGY STAR for Commercial LED: Which Certification Matters More?', excerpt: 'Both certifications signal quality, but they serve different purposes. For most commercial projects and utility rebate applications, DLC is the one that actually matters.', category: 'Compliance', date: 'March 2026', readTime: '6 min read' },
  { slug: 'title-24-jab-certification-explained', title: 'California Title 24 JA8 Certification: What ECs Need to Know Before Installation', excerpt: 'Installing a non-JA8 fixture on a California commercial project will fail the HERS inspection. Here\'s how to verify JA8 certification before your crew goes to work.', category: 'California', date: 'February 2026', readTime: '7 min read' },
];
---
<Base title="Commercial Lighting Blog for Electrical Contractors | Echelon Lighting" description="Commercial lighting insights for electrical contractors. Specification guides, energy code updates, manufacturer news, and utility rebate program changes.">
  <div class="section py-12">
    <div class="mb-10">
      <div class="text-xs font-bold uppercase tracking-widest text-blue-700 mb-2">Blog</div>
      <h1 class="text-4xl font-bold tracking-tight mb-3">Commercial Lighting Insights</h1>
      <p class="text-base text-gray-500 max-w-xl">Specification guides, energy code updates, and practical knowledge for electrical contractors working on commercial lighting projects.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {posts.map(post => (
        <a href={`/blog/${post.slug}/`} class="card p-6 no-underline group flex flex-col">
          <div class="text-xs font-bold uppercase tracking-wider text-blue-700 mb-2">{post.category}</div>
          <h2 class="text-base font-bold text-gray-900 group-hover:text-blue-700 transition-colors mb-3 flex-1 leading-snug">{post.title}</h2>
          <p class="text-sm text-gray-500 leading-relaxed mb-4">{post.excerpt}</p>
          <div class="flex justify-between text-xs text-gray-400"><span>{post.date}</span><span>{post.readTime}</span></div>
        </a>
      ))}
    </div>
  </div>
</Base>
