---
import Base from '../../layouts/Base.astro';
---
<Base title="Resources for Electrical Contractors | Commercial Lighting Guides | Echelon Lighting" description="Commercial lighting resources for electrical contractors. Title 24 compliance guides, DLC product selection, lighting specification checklists, and utility rebate program overviews.">
  <div class="section py-12">
    <div class="mb-10">
      <div class="text-xs font-bold uppercase tracking-widest text-blue-700 mb-2">EC Resources</div>
      <h1 class="text-4xl font-bold tracking-tight mb-3">Resources for Electrical Contractors</h1>
      <p class="text-base text-gray-500 max-w-xl">Practical guides, checklists, and specification resources for ECs working on commercial lighting projects.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
      {[
        { title: 'Commercial Lighting Specification Guide for ECs', desc: 'How to read and execute a commercial lighting schedule. Fixture types, mounting methods, control wiring, and submittal requirements.', category: 'Specification', href: '/resources/commercial-lighting-spec-guide/' },
        { title: 'California Title 24 Compliance Checklist for ECs', desc: 'Step-by-step checklist for Title 24 compliance on California commercial projects. JA8 verification, controls wiring, and HERS inspection prep.', category: 'California ECs', href: '/resources/title-24-compliance-checklist/' },
        { title: 'Utility Rebate Guide: Maximizing DLC Rebates for LED Retrofits', desc: 'How to identify DLC-qualified products, calculate rebate amounts, and submit claims to utility programs in your service territory.', category: 'Rebates', href: '/resources/utility-rebate-guide/' },
        { title: 'Addressable vs. Conventional Lighting Controls for Commercial Projects', desc: 'Technical guide to 0-10V, DALI, and networked control systems. When each protocol is required and how to spec the right driver.', category: 'Controls', href: '/resources/lighting-controls-guide/' },
        { title: 'Commercial Lighting Submittal Package Guide', desc: 'How to prepare a complete lighting submittal for architect or owner review. Cut sheets, photometrics, energy compliance documentation.', category: 'Project Management', href: '/resources/submittal-guide/' },
        { title: 'LED High Bay Selection Guide for Warehouse & Industrial', desc: 'How to specify the right high bay for warehouses, manufacturing, and cold storage. Efficacy, mounting height, optics, and DLC requirements.', category: 'Industrial', href: '/resources/high-bay-selection-guide/' },
      ].map(r => (
        <a href={r.href} class="card p-6 no-underline group flex flex-col">
          <div class="text-xs font-bold uppercase tracking-wider text-blue-700 mb-2">{r.category}</div>
          <h2 class="text-base font-bold text-gray-900 group-hover:text-blue-700 transition-colors mb-3 flex-1 leading-snug">{r.title}</h2>
          <p class="text-sm text-gray-500 leading-relaxed">{r.desc}</p>
        </a>
      ))}
    </div>
    <div class="bg-blue-700 rounded-2xl p-8 flex flex-col md:flex-row items-center justify-between gap-6">
      <div><h3 class="text-xl font-bold text-white mb-2">Have specs for an active project?</h3><p class="text-sm text-blue-200">Send us your lighting schedule — we'll respond with EC pricing within 24-48 hours.</p></div>
      <button onclick="openRFQ('','','Resources Page — Project Quote')" class="bg-white text-blue-700 px-8 py-3.5 rounded-full text-sm font-bold hover:bg-blue-50 cursor-pointer border-0 whitespace-nowrap">Request Project Pricing</button>
    </div>
  </div>
</Base>
