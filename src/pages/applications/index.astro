---
import Base from '../../layouts/Base.astro';
import { applications, manufacturers } from '../../data/manufacturers.js';
---

<Base
  title="Commercial Lighting by Application | Office, Warehouse, Healthcare & More | Echelon Lighting"
  description="Commercial lighting specifications by application type. Office, warehouse, healthcare, hospitality, education, retail, and parking. Manufacturer recommendations and energy code guidance for electrical contractors."
>
  <div class="section py-12">
    <div class="mb-10">
      <div class="text-xs font-bold uppercase tracking-widest text-blue-700 mb-2">By Application</div>
      <h1 class="text-4xl font-bold tracking-tight mb-3">Commercial Lighting by Application</h1>
      <p class="text-base text-gray-500 max-w-xl">Project-specific manufacturer recommendations, specification notes, and energy code requirements for each commercial application type.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {applications.map(app => (
        <a href={`/applications/${app.id}/`} class="card p-6 no-underline group">
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-blue-700 transition-colors mb-2">{app.name}</h2>
          <p class="text-sm text-gray-500 leading-relaxed mb-4">{app.description}</p>
          <div class="bg-gray-50 rounded-lg p-3 border border-gray-200">
            <p class="text-xs text-gray-600 leading-relaxed italic">{app.specs}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>
