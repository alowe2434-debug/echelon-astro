---
import Base from '../../layouts/Base.astro';
import { categories, manufacturers } from '../../data/manufacturers.js';
---

<Base
  title="Commercial Lighting by Category | Downlights, High Bay, Linear & More | Echelon Lighting"
  description="Browse commercial lighting by fixture category. Downlights, high bay, linear recessed, exterior, track lighting, controls, and more. EC pricing on 200+ manufacturer lines."
>
  <div class="section py-12">
    <div class="mb-10">
      <div class="text-xs font-bold uppercase tracking-widest text-blue-700 mb-2">Product Categories</div>
      <h1 class="text-4xl font-bold tracking-tight mb-3">Commercial Lighting by Category</h1>
      <p class="text-base text-gray-500 max-w-xl">Find the right fixture type for your project. Each category includes specification guidance, leading manufacturers, and energy code compliance notes.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {categories.map(cat => {
        const catMfrs = manufacturers.filter(m => m.categories.includes(cat.id));
        return (
          <a href={`/products/${cat.id}/`} class="card p-6 no-underline group">
            <h2 class="text-lg font-bold text-gray-900 group-hover:text-blue-700 transition-colors mb-2">{cat.name}</h2>
            <p class="text-sm text-gray-500 leading-relaxed mb-4">{cat.description}</p>
            <div class="text-xs text-gray-400 mb-3">{catMfrs.length} manufacturers available</div>
            <div class="flex flex-wrap gap-1.5">
              {catMfrs.slice(0,4).map(m => (
                <span class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded">{m.name}</span>
              ))}
              {catMfrs.length > 4 && <span class="text-xs text-gray-400">+{catMfrs.length - 4} more</span>}
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Base>
