---
import Base from '../../layouts/Base.astro';
import { manufacturers } from '../../data/manufacturers.js';
const buyAmericaMfrs = manufacturers.filter(m => m.certifications.includes('Buy America') || m.certifications.includes('Made in America'));
---
<Base title="Buy America Lighting Products | Federal Project Compliance | Echelon Lighting" description="Buy America and Buy American compliant commercial lighting for federally funded projects. Manufacturers with domestic production for infrastructure, transit, and government projects.">
  <div class="section py-12">
    <nav class="flex items-center gap-2 text-xs text-gray-400 mb-8"><a href="/" class="hover:text-gray-700 no-underline">Home</a><span>/</span><a href="/compliance/" class="hover:text-gray-700 no-underline">Compliance</a><span>/</span><span class="text-gray-700">Buy America</span></nav>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2">
        <div class="text-xs font-bold uppercase tracking-widest text-blue-700 mb-2">Federal Procurement</div>
        <h1 class="text-4xl font-bold tracking-tight mb-4">Buy America Compliant Commercial Lighting</h1>
        <p class="text-lg text-gray-500 leading-relaxed mb-8">Federal and state projects funded through transportation, infrastructure, or government programs typically require Buy America or Buy American compliant products. Echelon Lighting can source lighting fixtures from manufacturers with certified domestic production.</p>
        <h2 class="text-2xl font-bold tracking-tight mb-4">When Buy America Applies</h2>
        <div class="flex flex-col gap-3 mb-8">
          {['Projects receiving federal highway or transit funding (FHWA, FTA)','Infrastructure Investment and Jobs Act (IIJA) funded projects','Federal building projects subject to the Trade Agreements Act (TAA)','Some state-funded education and government projects','Public works projects with Buy America local ordinances'].map(r => <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg border border-gray-200"><span class="text-blue-700 flex-shrink-0">▸</span><span class="text-sm text-gray-700">{r}</span></div>)}
        </div>
        <h2 class="text-xl font-bold tracking-tight mb-4">Buy America Lighting Manufacturers</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-8">
          {buyAmericaMfrs.map(m => <a href={`/manufacturers/${m.id}/`} class="flex items-center justify-between p-4 border border-gray-200 rounded-lg hover:border-blue-300 no-underline group"><div><div class="text-sm font-bold text-gray-900 group-hover:text-blue-700">{m.name}</div><div class="text-xs text-gray-500 mt-0.5">{m.certifications.filter(c => c.includes('America')).join(', ')}</div></div><span class="text-xs text-blue-700">View →</span></a>)}
        </div>
        <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-5"><h3 class="text-sm font-bold text-yellow-800 mb-2">Important: Verify Before Specifying</h3><p class="text-sm text-yellow-700 leading-relaxed">Buy America requirements vary significantly by funding source and program. Always confirm requirements with the project owner or funding agency before specifying products. Echelon Lighting can assist with documentation for products we source.</p></div>
      </div>
      <div><div class="sticky top-20"><div class="bg-blue-700 rounded-xl p-5 text-white"><h3 class="text-sm font-bold mb-2">Buy America Sourcing</h3><p class="text-xs text-blue-200 leading-relaxed mb-4">Send your federal project specs — we'll confirm Buy America eligibility and documentation requirements.</p><button onclick="openRFQ('','','Buy America — Federal Project')" class="w-full bg-white text-blue-700 py-2.5 rounded-lg text-sm font-bold cursor-pointer border-0">Get Compliant Products</button></div></div></div>
    </div>
  </div>
</Base>
