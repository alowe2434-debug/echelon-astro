---
import Base from '../../layouts/Base.astro';
import { regions } from '../../data/regions.js';
import { manufacturers } from '../../data/manufacturers.js';

export async function getStaticPaths() {
  return regions.map(r => ({ params: { region: r.id }, props: { region: r } }));
}

const { region } = Astro.props;
const featuredMfrs = manufacturers.filter(m => m.tier === 1).slice(0, 6);
const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": `Echelon Lighting — ${region.name}`,
  "description": `Commercial lighting distribution for electrical contractors in ${region.name}. ${region.energyCode}.`,
  "areaServed": { "@type": "AdministrativeArea", "name": region.name },
  "serviceType": "Commercial Lighting Distribution"
};
---
<Base
  title={`Commercial Lighting for Electrical Contractors in ${region.name}, ${region.stateCode} | Echelon Lighting`}
  description={`Commercial lighting distribution for ECs in ${region.name}. ${region.energyCode}. Utility rebates: ${region.utilityRebates}. EC pricing, DLC products, nationwide delivery.`}
  schema={schema}
>
  <div class="section py-12">
    <nav class="flex items-center gap-2 text-xs text-gray-400 mb-8">
      <a href="/" class="hover:text-gray-700 no-underline">Home</a><span>/</span>
      <a href="/regions/" class="hover:text-gray-700 no-underline">Regions</a><span>/</span>
      <span class="text-gray-700">{region.name}</span>
    </nav>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2">
        <div class="text-xs font-bold uppercase tracking-widest text-blue-700 mb-2">{region.stateCode} — {region.metro} Metro</div>
        <h1 class="text-4xl font-bold tracking-tight mb-4">Commercial Lighting for {region.name} Electrical Contractors</h1>
        <p class="text-lg text-gray-500 leading-relaxed mb-8">Echelon Lighting supplies electrical contractors throughout {region.name} with specification-grade commercial lighting at EC pricing. All products meet {region.energyCode} requirements.</p>

        <!-- Energy Code -->
        <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 mb-8">
          <h2 class="text-lg font-bold mb-3">Energy Code: {region.name}</h2>
          <p class="text-sm text-gray-700 mb-2"><strong>Governing Code:</strong> {region.energyCode}</p>
          <p class="text-sm text-gray-700"><strong>Utility Rebate Programs:</strong> {region.utilityRebates}</p>
        </div>

        <!-- Key Code Requirements -->
        <h2 class="text-2xl font-bold tracking-tight mb-4">Key {region.name} Lighting Requirements</h2>
        <div class="flex flex-col gap-3 mb-8">
          {region.keyAmendments.map(a => (
            <div class="flex items-start gap-3 p-4 bg-white border border-gray-200 rounded-lg">
              <div class="w-5 h-5 bg-blue-700 rounded flex-shrink-0 flex items-center justify-center mt-0.5">
                <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </div>
              <p class="text-sm text-gray-700 leading-relaxed">{a}</p>
            </div>
          ))}
        </div>

        <!-- Key Industries -->
        <h2 class="text-2xl font-bold tracking-tight mb-4">Key Commercial Sectors in {region.metro}</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-8">
          {region.keyIndustries.map(ind => (
            <div class="p-3 bg-gray-50 border border-gray-200 rounded-lg text-center">
              <span class="text-sm font-medium text-gray-700 capitalize">{ind}</span>
            </div>
          ))}
        </div>

        <!-- Sub-regions -->
        <h2 class="text-2xl font-bold tracking-tight mb-4">Cities We Serve in {region.name}</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 mb-8">
          {region.townships.map(t => (
            <a href={`/regions/${region.id}/${t.id}/`} class="p-3 bg-white border border-gray-200 rounded-lg hover:border-blue-300 hover:bg-blue-50 transition-all no-underline group text-center">
              <span class="text-sm font-medium text-gray-800 group-hover:text-blue-700">{t.name}</span>
            </a>
          ))}
        </div>

        <!-- Top Manufacturers -->
        <h2 class="text-2xl font-bold tracking-tight mb-4">Top Manufacturers for {region.metro} Projects</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
          {featuredMfrs.map(m => (
            <a href={`/manufacturers/${m.id}/`} class="p-3 border border-gray-200 rounded-lg hover:border-blue-300 hover:bg-blue-50 no-underline group">
              <div class="text-sm font-bold text-gray-900 group-hover:text-blue-700">{m.name}</div>
              <div class="text-xs text-gray-400 mt-0.5">{m.certifications.slice(0,2).join(' · ')}</div>
            </a>
          ))}
        </div>
      </div>

      <div>
        <div class="sticky top-20 flex flex-col gap-5">
          <div class="bg-blue-700 rounded-xl p-5 text-white">
            <h3 class="text-sm font-bold mb-2">EC Pricing for {region.metro} Projects</h3>
            <p class="text-xs text-blue-200 leading-relaxed mb-4">Send your {region.metro} project specs for EC pricing. We understand {region.stateCode} energy codes and utility rebate requirements.</p>
            <button onclick={`openRFQ('','','${region.name} EC Pricing Request')`} class="w-full bg-white text-blue-700 py-2.5 rounded-lg text-sm font-bold hover:bg-blue-50 cursor-pointer border-0">Get EC Pricing</button>
          </div>
          <div class="bg-white border border-gray-200 rounded-xl p-5">
            <h3 class="text-sm font-bold mb-3">Quick Facts</h3>
            <div class="flex flex-col gap-2 text-xs">
              <div class="flex justify-between py-2 border-b border-gray-100"><span class="text-gray-500">Energy Code</span><span class="font-medium text-gray-900 text-right max-w-[55%]">{region.energyCode.split('(')[0].trim()}</span></div>
              <div class="flex justify-between py-2 border-b border-gray-100"><span class="text-gray-500">Metro</span><span class="font-medium text-gray-900">{region.metro}</span></div>
              <div class="flex justify-between py-2"><span class="text-gray-500">Cities Covered</span><span class="font-medium text-gray-900">{region.townships.length}</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>
