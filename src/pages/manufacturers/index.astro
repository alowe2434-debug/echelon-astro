---
import Base from '../../layouts/Base.astro';
import { manufacturers } from '../../data/manufacturers.js';

const tier1 = manufacturers.filter(m => m.tier === 1);
const tier2 = manufacturers.filter(m => m.tier === 2);
const tier3 = manufacturers.filter(m => m.tier === 3);
---

<Base
  title="Commercial Lighting Manufacturers | 200+ Brands | Echelon Lighting"
  description="Authorized distributor for 200+ commercial lighting manufacturers. Lithonia, Juno, Focal Point, RAB, Cree, USAI, and more. Spec-grade products with EC pricing and nationwide delivery."
>
  <div class="section py-12">
    <div class="mb-10">
      <div class="text-xs font-bold uppercase tracking-widest text-blue-700 mb-2">Manufacturer Directory</div>
      <h1 class="text-4xl font-bold tracking-tight mb-3">Commercial Lighting Manufacturers</h1>
      <p class="text-base text-gray-500 max-w-xl">200+ specification-grade manufacturers. If it's on the plans, we can source it. Click any brand to learn about their product lines and request pricing.</p>
    </div>

    <!-- Tier 1 -->
    <div class="mb-3">
      <h2 class="text-sm font-bold uppercase tracking-wider text-gray-400 mb-4">Most Specified — Tier 1</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
        {tier1.map(m => (
          <a href={`/manufacturers/${m.id}/`} class="card p-6 no-underline group">
            <div class="flex items-start justify-between mb-3">
              <div>
                <h3 class="text-lg font-bold text-gray-900 group-hover:text-blue-700 transition-colors">{m.name}</h3>
                {m.parent !== 'Independent' && <p class="text-xs text-gray-400 mt-0.5">{m.parent}</p>}
              </div>
              <div class="flex flex-wrap gap-1 justify-end">
                {m.certifications.slice(0,2).map(c => (
                  <span class="text-xs bg-blue-50 text-blue-700 px-2 py-0.5 rounded font-mono font-bold">{c}</span>
                ))}
              </div>
            </div>
            <p class="text-sm text-gray-600 leading-relaxed mb-3">{m.specialty}</p>
            <div class="flex flex-wrap gap-1.5">
              {m.categories.slice(0,4).map(c => (
                <span class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded">{c.replace(/-/g,' ')}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Tier 2 -->
    <div class="mb-3">
      <h2 class="text-sm font-bold uppercase tracking-wider text-gray-400 mb-4">Highly Specified — Tier 2</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
        {tier2.map(m => (
          <a href={`/manufacturers/${m.id}/`} class="card p-5 no-underline group">
            <h3 class="text-base font-bold text-gray-900 group-hover:text-blue-700 transition-colors mb-1">{m.name}</h3>
            {m.parent !== 'Independent' && <p class="text-xs text-gray-400 mb-2">{m.parent}</p>}
            <p class="text-xs text-gray-500 leading-relaxed mb-3">{m.specialty}</p>
            <div class="flex flex-wrap gap-1">
              {m.certifications.slice(0,3).map(c => (
                <span class="text-xs bg-gray-100 text-gray-600 px-1.5 py-0.5 rounded font-mono">{c}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Tier 3 -->
    <div class="mb-3">
      <h2 class="text-sm font-bold uppercase tracking-wider text-gray-400 mb-4">Specialty Manufacturers — Tier 3</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 mb-10">
        {tier3.map(m => (
          <a href={`/manufacturers/${m.id}/`} class="card p-4 no-underline group">
            <h3 class="text-sm font-bold text-gray-900 group-hover:text-blue-700 transition-colors mb-1">{m.name}</h3>
            <p class="text-xs text-gray-500 leading-snug">{m.specialty.split(' — ')[0]}</p>
          </a>
        ))}
      </div>
    </div>

    <!-- 200+ More -->
    <div class="bg-blue-50 border border-blue-100 rounded-2xl p-8 text-center">
      <h3 class="text-lg font-bold mb-2">Don't see your manufacturer?</h3>
      <p class="text-sm text-gray-600 max-w-lg mx-auto mb-5">We represent 200+ manufacturers. If the brand appears on commercial lighting specifications, we can source it. Send us the spec sheet and we'll confirm availability and pricing within 24 hours.</p>
      <button onclick="openRFQ('','','Manufacturer Sourcing Request')" class="btn-primary">Send Your Spec Sheet</button>
    </div>
  </div>
</Base>
